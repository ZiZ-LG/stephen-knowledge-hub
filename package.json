{
  "name": "stephen-knowledge-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.editorial.json",
    "test": "vitest run",
    "audit:public": "node --experimental-strip-types scripts/public-repo-audit.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run audit:public"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "5.6.3",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
